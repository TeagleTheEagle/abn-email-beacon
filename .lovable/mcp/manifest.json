{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "abn-email-beacon",
      "version": "0.1.0",
      "title": "Abn Email Beacon"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List Teague Industries' services with price and what's included.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_faqs",
        "title": "List FAQs",
        "description": "List frequently asked questions and answers about working with Teague Industries.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List shop products",
        "description": "List products for sale in the Teague Industries shop, with price and link.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "request_free_preview",
        "title": "Request a free preview",
        "description": "Send Teague Industries a free website/store preview enquiry for a business.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Contact person's name."
            },
            "business_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "description": "Business name."
            },
            "email": {
              "type": "string",
              "maxLength": 255,
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Contact email."
            },
            "phone": {
              "description": "Contact phone (optional).",
              "type": "string",
              "maxLength": 30
            },
            "message": {
              "description": "What the business needs (optional).",
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "name",
            "business_name",
            "email"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
